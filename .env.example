# OUZ Experience — variáveis de ambiente (EXEMPLO; não coloque valores reais aqui)
# Copie para .env.local em desenvolvimento. Em produção, configure na Vercel.

# development | preview | production
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (projeto próprio da OUZ; dev e produção separados)
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (sb_publishable_...) ou a chave "anon" legada
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...) ou "service_role" legada. SOMENTE servidor; nunca expor ao navegador.
SUPABASE_SECRET_KEY=

# E-mail: "log" (padrão; não envia nada) ou "resend" (somente produção autorizada)
EMAIL_MODE=log
RESEND_API_KEY=
EMAIL_FROM=
# Ex.: OUZ Experience <nao-responda@ouz.app.br>

# Rotinas agendadas (Vercel Cron envia este segredo no header Authorization)
CRON_SECRET=

# Versões vigentes dos textos legais (placeholders até a OUZ fornecer)
NEXT_PUBLIC_TERMS_VERSION=rascunho-2026-10
NEXT_PUBLIC_PRIVACY_VERSION=rascunho-2026-10
